# Neon Postgres (pooled connection string). Use a `dev` branch locally.
DATABASE_URL=""
# Public origin of the app, e.g. http://localhost:5173
ORIGIN="http://localhost:5173"
# 32+ random bytes: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Sign-in providers. Each is enabled when its client ID is set.
# Callback URL for each: <ORIGIN>/api/auth/callback/<provider>
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Magic links. Without RESEND_API_KEY, links are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM=""

# Chain. 31337 = local Hardhat, 84532 = Base Sepolia, 8453 = Base.
PUBLIC_CHAIN_ID="31337"
PUBLIC_RAFFLE_CONTRACT=""
# Server RPC and the RPC browsers use to verify. Default: the chain's public RPC.
RPC_URL=""
PUBLIC_RPC_URL=""
# The server's key: requests draws and pays their gas. Use a fresh key, never a wallet's.
DRAWER_PRIVATE_KEY=""

# Used by `pnpm -C contracts deploy:base-sepolia` only.
# Empty subscription ID: the drawer creates and funds one itself.
VRF_SUBSCRIPTION_ID=""
# "link" or "eth". Empty: LINK if the drawer holds 3+, otherwise ETH.
VRF_PAY_WITH=""
# A wallet to hand contract ownership to (accept it on /admin). Empty: the drawer owns it.
OWNER_ADDRESS=""
