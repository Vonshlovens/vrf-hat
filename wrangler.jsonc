{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vrf-hat",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  // One canonical address: sign-in cookies and OAuth callbacks are tied to ORIGIN.
  "routes": [{ "pattern": "vrf-hat.ericevans.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Non-secret settings. Secrets (DATABASE_URL, BETTER_AUTH_SECRET,
  // DRAWER_PRIVATE_KEY, ...) are set with `wrangler secret put`.
  "vars": {
    "ORIGIN": "https://vrf-hat.ericevans.dev",
    "PUBLIC_CHAIN_ID": "84532",
    "PUBLIC_RAFFLE_CONTRACT": "0x9f64ac57f76fe348e8c240478769b89986e4dbf8",
    "GITHUB_CLIENT_ID": "Ov23ctLLulKJJDB1Ibrm",
    // Used once RESEND_API_KEY is set; until then magic links go to the logs.
    "EMAIL_FROM": "VRF Hat <hat@mail.ericevans.dev>",
  },
}
