{
  "name": "vrf-hat",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "wrangler types --include-runtime=false && vp -C . build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "vp config && (wrangler types --include-runtime=false >/dev/null; svelte-kit sync) || echo ''",
    "check": "wrangler types --include-runtime=false && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen": "wrangler types --include-runtime=false",
    "test": "vp test --run && pnpm -C contracts test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
    "chain": "pnpm -C contracts node",
    "chain:deploy": "pnpm -C contracts deploy:local",
    "verify-draw": "node scripts/verify-draw.ts",
    "faucet": "node scripts/faucet.ts"
  },
  "dependencies": {
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "^1.61.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24",
    "auth": "^1.6.24",
    "better-auth": "^1.6.24",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.97.0"
  }
}
